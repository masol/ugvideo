{
    "icon": "IconSquarePlus",
    "statusText": "通用任务",
    "chatMode": true,
    "api": [
        "icon"
    ],
    "header": {
        "title": "通用任务",
        "detail": "聊天窗里说一句话（比如“整理上周销售数据”），配置里细化具体步骤（可填可不填）。两者一起，一键生成干活流程并执行。"
    },
    "hints": {
        "idle": "💬 在「聊天窗」随便说想干啥（模糊任务也行）；🛠️ 在「输入管理」精调步骤细节（不填也没事）。点运行，两者合并开干。"
    },
    "checkInput": {
        "title": "输入管理还没放步骤",
        "description": "没关系，聊天窗里已经说了要干啥，也能直接运行。如果想控制每一步怎么走，再回来添加步骤就行。"
    },
    "targets": [
        {
            "label": "工作流理解",
            "desc": "解析用户输入，提取任务、步骤、约束",
            "icon": "IconFileSearch"
        },
        {
            "label": "工作流设计",
            "desc": "生成初始工作流骨架（步骤、依赖、分支）",
            "icon": "IconHierarchy"
        },
        {
            "label": "工作流测试",
            "desc": "使用模拟数据执行工作流，验证逻辑完整性",
            "icon": "IconBug"
        },
        {
            "label": "工作流优化",
            "desc": "根据人工或自动评价迭代改进工作流",
            "icon": "IconArrowsUp"
        },
        {
            "label": "工作流导出",
            "desc": "产出标准化工作流定义（JSON/YAML）及执行报告",
            "icon": "IconFileDownload"
        }
    ],
    "activities": [
        {
            "id": "input-manager",
            "label": "输入管理（精调步骤）",
            "icon": "IconBook2",
            "panel": {
                "type": "panel",
                "children": [
                    {
                        "type": "accordion-section",
                        "title": "步骤清单",
                        "icon": "IconScript",
                        "defaultOpen": true,
                        "children": [
                            {
                                "type": "text-list",
                                "binding": {
                                    "key": "script"
                                },
                                "addLabel": "加一个工作流",
                                "emptyTitle": "还没写步骤（空着也行，聊天窗的任务直接搞定）",
                                "emptyIcon": "IconFileText",
                                "addDialogTitle": "新增一个工作流",
                                "editDialogTitle": "改改这一工作流",
                                "editDialogDescription": "写清楚做什么、输什么、遇错怎么办。如果聊天窗已说了目标，这里就当补充细节。",
                                "editAlert": true,
                                "confirmTitle": "删掉这步？",
                                "confirmMessage": "删了可能影响精度，不过聊天窗兜底，确定吗？"
                            },
                            {
                                "type": "field",
                                "binding": {
                                    "key": "workflow_goal"
                                },
                                "label": "目标与产出",
                                "editor": "dialog",
                                "dialogTitle": "编辑目标",
                                "dialogDescription": "描述该工作流要解决什么问题、最终产出什么。",
                                "emptyHint": "点击设定目标与产出"
                            }
                        ]
                    },
                    {
                        "type": "accordion-section",
                        "title": "约束与偏好",
                        "icon": "IconListCheck",
                        "children": [
                            {
                                "type": "field",
                                "binding": {
                                    "key": "constraints"
                                },
                                "label": "硬性约束",
                                "editor": "dialog",
                                "dialogTitle": "编辑约束",
                                "dialogDescription": "例如：数据源只允许本地文件、必须包含审计日志、响应时间 < 2s。",
                                "emptyHint": "点击添加硬性约束"
                            },
                            {
                                "type": "field",
                                "binding": {
                                    "key": "preferences"
                                },
                                "label": "偏好与权衡",
                                "editor": "dialog",
                                "dialogTitle": "编辑偏好",
                                "dialogDescription": "例如：优先可读性 vs 性能、倾向并行执行等。",
                                "emptyHint": "点击添加偏好"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "spec-setting",
            "label": "工坊配置",
            "icon": "IconSettings",
            "panel": {
                "type": "panel",
                "children": [
                    {
                        "type": "accordion-section",
                        "title": "迭代控制",
                        "icon": "IconRepeat",
                        "defaultOpen": true,
                        "children": [
                            {
                                "type": "field",
                                "binding": {
                                    "key": "maxTargetRounds"
                                },
                                "label": "主循环最大循环次数",
                                "editor": "inline",
                                "placeholder": "30",
                                "inputType": "number"
                            },
                            {
                                "type": "field",
                                "binding": {
                                    "key": "maxUserTimeout"
                                },
                                "label": "等待用户澄清最大时长",
                                "editor": "inline",
                                "placeholder": "1h",
                                "inputType": "string"
                            },
                            {
                                "type": "field",
                                "binding": {
                                    "key": "maxPathsPerNode"
                                },
                                "label": "DAG最大路径长度",
                                "editor": "inline",
                                "placeholder": "50",
                                "inputType": "number"
                            },
                            {
                                "type": "field",
                                "binding": {
                                    "key": "maxReactRounds"
                                },
                                "label": "转标准格式最大收敛次数",
                                "editor": "inline",
                                "placeholder": "4",
                                "inputType": "number"
                            }
                        ]
                    }
                ]
            }
        }
    ],
    "blueprintFilters": {
        "glossary": [
            {
                "value": "#workflow:current:root",
                "desc": "当前工作流的根节点树"
            },
            {
                "value": "#workflow:iterations",
                "desc": "迭代历史记录（含评分、反馈、改动）"
            },
            {
                "value": "#workflow:export:url",
                "desc": "最终工作流文件的下载地址"
            },
            {
                "value": "#workflow:export:report",
                "desc": "构建报告文本"
            },
            {
                "value": "#workflow:test:results",
                "desc": "测试用例执行结果集"
            }
        ]
    }
}