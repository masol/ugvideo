{
    "icon": "IconSquarePlus",
    "statusText": "工作流工坊",
    "chatMode": true,
    "api": [
        "icon"
    ],
    "header": {
        "title": "工作流工坊",
        "detail": "用自然语言描述人类工作流，Unigen 自动构建、迭代、导出可执行 AI 工作流"
    },
    "hints": {
        "idle": "在「输入管理」中描述您的工作流，然后点击「运行」开始自动构建。"
    },
    "checkInput": {
        "title": "尚未定义工作流",
        "description": "请先在「输入管理」中添加工作流描述或步骤清单。"
    },
    "targets": [
        {
            "label": "工作流理解",
            "desc": "解析用户输入，提取任务、步骤、约束",
            "icon": "IconFileSearch"
        },
        {
            "label": "工作流设计",
            "desc": "生成初始工作流骨架（步骤、依赖、分支）",
            "icon": "IconHierarchy"
        },
        {
            "label": "工作流测试",
            "desc": "使用模拟数据执行工作流，验证逻辑完整性",
            "icon": "IconBug"
        },
        {
            "label": "工作流优化",
            "desc": "根据人工或自动评价迭代改进工作流",
            "icon": "IconArrowsUp"
        },
        {
            "label": "工作流导出",
            "desc": "产出标准化工作流定义（JSON/YAML）及执行报告",
            "icon": "IconFileDownload"
        }
    ],
    "activities": [
        {
            "id": "input-manager",
            "label": "输入管理",
            "icon": "IconBook2",
            "panel": {
                "type": "panel",
                "children": [
                    {
                        "type": "accordion-section",
                        "title": "工作流描述",
                        "icon": "IconScript",
                        "defaultOpen": true,
                        "children": [
                            {
                                "type": "text-list",
                                "binding": {
                                    "key": "script"
                                },
                                "addLabel": "添加工作流",
                                "emptyTitle": "还没有工作流",
                                "emptyIcon": "IconFileText",
                                "addDialogTitle": "添加一个工作流的描述",
                                "editDialogTitle": "编辑工作流",
                                "editDialogDescription": "用自然语言描述此工作流的步骤、规则、输入输出、异常处理等。",
                                "editAlert": true,
                                "confirmTitle": "删除工作流",
                                "confirmMessage": "删除后需重新构建，确定继续吗？"
                            },
                            {
                                "type": "field",
                                "binding": {
                                    "key": "workflow_goal"
                                },
                                "label": "目标与产出",
                                "editor": "dialog",
                                "dialogTitle": "编辑目标",
                                "dialogDescription": "描述该工作流要解决什么问题、最终产出什么。",
                                "emptyHint": "点击设定目标与产出"
                            }
                        ]
                    },
                    {
                        "type": "accordion-section",
                        "title": "约束与偏好",
                        "icon": "IconListCheck",
                        "children": [
                            {
                                "type": "field",
                                "binding": {
                                    "key": "constraints"
                                },
                                "label": "硬性约束",
                                "editor": "dialog",
                                "dialogTitle": "编辑约束",
                                "dialogDescription": "例如：数据源只允许本地文件、必须包含审计日志、响应时间 < 2s。",
                                "emptyHint": "点击添加硬性约束"
                            },
                            {
                                "type": "field",
                                "binding": {
                                    "key": "preferences"
                                },
                                "label": "偏好与权衡",
                                "editor": "dialog",
                                "dialogTitle": "编辑偏好",
                                "dialogDescription": "例如：优先可读性 vs 性能、倾向并行执行等。",
                                "emptyHint": "点击添加偏好"
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "spec-setting",
            "label": "工坊配置",
            "icon": "IconSettings",
            "panel": {
                "type": "panel",
                "children": [
                    {
                        "type": "accordion-section",
                        "title": "迭代控制",
                        "icon": "IconRepeat",
                        "defaultOpen": true,
                        "children": [
                            {
                                "type": "field",
                                "binding": {
                                    "key": "maxReactRounds"
                                },
                                "label": "转标准格式最大收敛次数",
                                "editor": "inline",
                                "placeholder": "4",
                                "inputType": "number"
                            },
                            {
                                "type": "field",
                                "binding": {
                                    "key": "maxPathsPerNode"
                                },
                                "label": "DAG最大路径长度",
                                "editor": "inline",
                                "placeholder": "50",
                                "inputType": "number"
                            },
                            {
                                "type": "button-group",
                                "binding": {
                                    "key": "config:improvement_strategy"
                                },
                                "label": "改进策略",
                                "icon": "IconWand",
                                "fallback": "refine",
                                "columns": 2,
                                "options": [
                                    {
                                        "value": "refine",
                                        "label": "细化",
                                        "sub": "在现有结构上微调",
                                        "dot": "bg-blue-500"
                                    },
                                    {
                                        "value": "restructure",
                                        "label": "重构",
                                        "sub": "允许调整步骤拓扑",
                                        "dot": "bg-purple-500"
                                    },
                                    {
                                        "value": "parallel",
                                        "label": "并行探索",
                                        "sub": "同时尝试多个变体",
                                        "dot": "bg-green-500"
                                    },
                                    {
                                        "value": "fallback",
                                        "label": "回退",
                                        "sub": "保留稳定版本，回退无效改动",
                                        "dot": "bg-amber-500"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    ],
    "blueprintFilters": {
        "glossary": [
            {
                "value": "#workflow:current:root",
                "desc": "当前工作流的根节点树"
            },
            {
                "value": "#workflow:iterations",
                "desc": "迭代历史记录（含评分、反馈、改动）"
            },
            {
                "value": "#workflow:export:url",
                "desc": "最终工作流文件的下载地址"
            },
            {
                "value": "#workflow:export:report",
                "desc": "构建报告文本"
            },
            {
                "value": "#workflow:test:results",
                "desc": "测试用例执行结果集"
            }
        ]
    }
}